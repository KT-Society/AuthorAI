# AuthorAI — Umgebungsvariablen
#
# Kopiere diese Datei nach `.env` und fülle die Keys aus:
#   cp .env.example .env
#
# Die Datei wird ausschließlich SERVERSEITIG gelesen und niemals an den Browser
# ausgeliefert. `.env` ist gitignored — bitte niemals echte Keys committen.

# ── erforderlich ─────────────────────────────────────────────────────────

# Sprachmodelle (Storyboard, Rohentwurf, Ausbau, Kohärenz, Stil, Soul-Scan)
# Entfällt, wenn in den Einstellungen ein eigener Anbieter hinterlegt ist.
OPENROUTER_API_KEY=

# Recherche (Charakter-Scan + /api/research)
TAVILY_API_KEY=

# Cover-Bilderzeugung (Pollinations)
POLLINATIONS_API_KEY=

# ── optional ─────────────────────────────────────────────────────────────

# Eigener OpenAI-kompatibler Anbieter statt OpenRouter (Override vor der
# gespeicherten Konfiguration; der Key wird niemals geloggt).
# AUTHORAI_PROVIDER=openrouter
# AUTHORAI_BASE_URL=https://api.openai.com/v1
# AUTHORAI_API_KEY=

# Pollinations API-Basis (Standard: https://gen.pollinations.ai)
# POLLINATIONS_API_BASE=https://gen.pollinations.ai

# Auswählbare Sprachen + Fallback (promptgen-Config)
# PROMPTGEN_LANGUAGES=German,English,Japanese,French
# PROMPTGEN_DEFAULT_LANGUAGE=German

# Port des promptgen-Servers (Standard: 3001; die Root-App nutzt 3000)
# PORT=3001

# Standalone-Binary: Browser beim Start automatisch öffnen (0 = aus)
# AUTHORAI_OPEN=0
