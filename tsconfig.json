{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "react"],

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "paths": {
      "@/*": ["./src/*"],
      "@promptgen/*": ["./packages/promptgen/src/*"]
    },

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },

  // `packages/promptgen` ist ein eigenes Paket mit **eigener** tsconfig, eigenem React (18 + MUI
  // statt 19) und eigenen Typen. Es hier mitzuprüfen erzeugt Scheinfehler (z. B. „ThemeProvider
  // cannot be used as a JSX component", weil zwei React-Typwelten aufeinandertreffen) — geprüft
  // wird es in seinem eigenen Paket, importierte Module löst dieses Projekt weiterhin auf.
  "exclude": ["dist", "node_modules", "packages"]
}
