{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": "KT-Society & Echo",
  "maintainers": ["KT-Society", "Echo"],
  "workspaces": ["packages/*"],
  "scripts": {
    "dev": "bun run scripts/all.ts dev",
    "start": "bun run scripts/all.ts start",
    "build": "bun run scripts/all.ts build",
    "build:binary": "bun run scripts/build-binary.ts",
    "check": "bun run scripts/check.ts",

    "dev:root": "bun --hot src/index.ts",
    "start:root": "NODE_ENV=production bun src/index.ts",
    "build:root": "bun run build.ts"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/bun": "latest",
    "tailwindcss": "^4.1.11"
  }
}
